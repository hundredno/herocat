{
  "name": "herocat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/size-check.js",
    "bot:playtest": "node scripts/record/playtest.js",
    "record:youtube": "node scripts/record/record.js --video youtube --seed 10",
    "record:short": "npm run record:youtube -- --dry && node scripts/record/record.js --video short --seed 7 --skip-build --save recordings/youtube-seed10/saves/save-deep-dark.json",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
